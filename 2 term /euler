import sys
input = sys.stdin.readline

def euler(n, edges):
    adj = [[] for _ in range(n)]
    for idx, (a, b) in enumerate(edges):
        adj[a].append((b, idx))
        adj[b].append((a, idx))

    vert = [i for i in range(n) if len(adj[i]) % 2 == 1]
    if len(vert) not in (0, 2):
        return None

    start = vert[0] if vert else next((i for i in range(n) if adj[i]), None)
    if start is None:
        return []

    used = [False] * len(edges)
    route = []
    stack = [start]

    while stack:
        v = stack[-1]
        for i in range(len(adj[v])):
            u, eid = adj[v][i]
            if not used[eid]:
                used[eid] = True
                stack.append(u)
                break
        else:
            route.append(stack.pop())

    return route[::-1] if len(route) == len(edges) + 1 else None

n, m = map(int, input().split())
edges = [tuple(map(lambda x: int(x)-1, input().split())) for _ in range(m)]

ans = euler(n, edges)
if ans is None:
    print("Нет эйлерова пути")
else:
    print(*(x + 1 for x in ans))
