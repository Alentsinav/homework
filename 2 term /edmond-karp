from collections import deque
import sys

input = sys.stdin.readline

def bfs(g, s, t, p):
    q = deque([s])
    used = {s}
    while q:
        v = q.popleft()
        for to in g[v]:
            if to not in used and g[v][to] > 0:
                used.add(to)
                p[to] = v
                q.append(to)
                if to == t:
                    return 1
    return 0
def maxflow(g, s, t):
    ans = 0
    while 1:
        p = {}
        if not bfs(g, s, t, p):
            break
        add = 10**18
        v = t
        while v != s:
            u = p[v]
            if g[u][v] < add:
                add = g[u][v]
            v = u
        v = t
        while v != s:
            u = p[v]
            g[u][v] -= add
            g[v][u] += add
            v = u
        ans += add
    return ans
m = int(input())
g = {}
for _ in range(m):
    u, v, c = input().split()
    c = int(c)
    if u not in g:
        g[u] = {}
    if v not in g:
        g[v] = {}
    if v not in g[u]:
        g[u][v] = 0
    if u not in g[v]:
        g[v][u] = 0
    g[u][v] += c
s, t = input().split()
print(maxflow(g, s, t))
