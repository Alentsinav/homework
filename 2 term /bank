from collections import deque
import sys

input = sys.stdin.readline

def bfs():
    q = deque([s])
    par = {s: -1}
    while q:
        v = q.popleft()
        for to in cap[v]:
            if to in par:
                continue
            if cap[v][to] - f[v][to] <= 0:
                continue
            par[to] = v
            q.append(to)
            if to == t:
                return par
    return None
def maxflow():
    ans = 0
    while 1:
        par = bfs()
        if not par:
            break
        add = 10**18
        v = t
        while v != s:
            u = par[v]
            add = min(add, cap[u][v] - f[u][v])
            v = u
        v = t
        while v != s:
            u = par[v]
            f[u][v] += add
            f[v][u] -= add
            v = u
        ans += add
    return ans
n, m = map(int, input().split())
a = list(map(int, input().split()))
b = list(map(int, input().split()))
s = 0
t = n + m + 1
cap = {}
f = {}
for i in range(t + 1):
    cap[i] = {}
    f[i] = {}
for i in range(n):
    cap[s][i + 1] = a[i]
    cap[i + 1][s] = 0
    f[s][i + 1] = 0
    f[i + 1][s] = 0
for j in range(m):
    v = n + 1 + j
    cap[v][t] = b[j]
    cap[t][v] = 0
    f[v][t] = 0
    f[t][v] = 0
INF = 10**9
for i in range(n):
    for j in range(m):
        u = j + 1 + n
        v = i + 1
        cap[u][v] = INF
        cap[v][u] = 0
        f[u][v] = 0
        f[v][u] = 0
total = sum(a)
print("YES" if maxflow() == total else "NO")
