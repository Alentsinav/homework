import sys

input = sys.stdin.readline

def kuhn(v):
    for to in g[v]:
        if used[to]:
            continue
        used[to] = 1
        if mt[to] == -1 or kuhn(mt[to]):
            mt[to] = v
            return 1
    return 0
n, m, e = map(int, input().split())
g = [[] for _ in range(n)]
for _ in range(e):
    a, b = map(int, input().split())
    a -= 1
    b -= 1
    g[a].append(b)
mt = [-1] * m
for i in range(n):
    used = [0] * m
    kuhn(i)
res = []
for j in range(m):
    if mt[j] != -1:
        res.append((mt[j], j))
used_l = [0] * n
used_r = [0] * m
for a, b in res:
    used_l[a] = 1
    used_r[b] = 1
for i in range(n):
    if not used_l[i]:
        for j in g[i]:
            res.append((i, j))
            used_l[i] = 1
            used_r[j] = 1
            break
for j in range(m):
    if not used_r[j]:
        for i in range(n):
            if j in g[i]:
                res.append((i, j))
                used_r[j] = 1
                used_l[i] = 1
                break
print(len(res))
for a, b in res:
    print(a + 1, b + 1)
